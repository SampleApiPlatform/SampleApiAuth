{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "11277324625122047166"
    }
  },
  "parameters": {
    "containerAppName": {
      "type": "string",
      "defaultValue": "sampleauthapi",
      "metadata": {
        "description": "Name of the container app"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "managedEnvironmentId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the Container Apps managed environment"
      }
    },
    "containerImage": {
      "type": "string",
      "defaultValue": "[format('docker.io/popdemar/{0}:latest', parameters('containerAppName'))]"
    },
    "managedIdentityId": {
      "type": "string",
      "defaultValue": "/subscriptions/c13b401c-dde4-4298-ad6c-3ef836f847d5/resourcegroups/sampleApiPlatform_rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/SampleDataAccessApi_UserKey"
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 1
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 5
    },
    "targetPort": {
      "type": "int",
      "defaultValue": 8080
    },
    "cpu": {
      "type": "string",
      "defaultValue": "0.5"
    },
    "memory": {
      "type": "string",
      "defaultValue": "1Gi"
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "sampleapiplatform-kv",
      "metadata": {
        "description": "Name of the Key Vault holding the app secrets"
      }
    },
    "keyVaultUri": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "URI of the Key Vault passed to the container as a secret (leave empty to derive it from keyVaultName)"
      }
    }
  },
  "variables": {
    "resolvedKeyVaultUri": "[if(not(equals(parameters('keyVaultUri'), '')), parameters('keyVaultUri'), format('https://{0}.{1}', parameters('keyVaultName'), environment().suffixes.keyvaultDns))]"
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-01",
      "name": "[parameters('containerAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned, UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('managedIdentityId'))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[parameters('managedEnvironmentId')]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "secrets": [
            {
              "name": "keyvaulturi",
              "value": "[variables('resolvedKeyVaultUri')]"
            }
          ],
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": "[parameters('targetPort')]",
            "exposedPort": 0,
            "transport": "Auto",
            "traffic": [
              {
                "weight": 100,
                "latestRevision": true
              }
            ],
            "allowInsecure": false,
            "ipSecurityRestrictions": [],
            "clientCertificateMode": "Ignore",
            "stickySessions": {
              "affinity": "none"
            }
          },
          "registries": [],
          "dapr": {
            "enabled": true,
            "appId": "[parameters('containerAppName')]",
            "appProtocol": "http",
            "appPort": "[parameters('targetPort')]",
            "httpReadBufferSize": 65,
            "httpMaxRequestSize": 4,
            "logLevel": "info",
            "enableApiLogging": true
          },
          "maxInactiveRevisions": 100
        },
        "template": {
          "containers": [
            {
              "name": "[parameters('containerAppName')]",
              "image": "[parameters('containerImage')]",
              "env": [
                {
                  "name": "ASPNETCORE_FORWARDEDHEADERS_ENABLED",
                  "value": "true"
                },
                {
                  "name": "KeyVaultUri",
                  "secretRef": "keyvaulturi"
                }
              ],
              "resources": {
                "cpu": "[json(parameters('cpu'))]",
                "memory": "[parameters('memory')]"
              },
              "probes": [
                {
                  "type": "Liveness",
                  "failureThreshold": 3,
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10,
                  "successThreshold": 1,
                  "tcpSocket": {
                    "port": "[parameters('targetPort')]"
                  },
                  "timeoutSeconds": 5
                },
                {
                  "type": "Readiness",
                  "failureThreshold": 3,
                  "initialDelaySeconds": 5,
                  "periodSeconds": 5,
                  "successThreshold": 1,
                  "tcpSocket": {
                    "port": "[parameters('targetPort')]"
                  },
                  "timeoutSeconds": 5
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "fqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2023-05-01').configuration.ingress.fqdn]"
    },
    "containerAppId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/containerApps', parameters('containerAppName'))]"
    }
  }
}